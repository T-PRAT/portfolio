---
import '../styles/global.css'
import ScrollNav from '../components/ui/ScrollNav.astro'

export interface Props {
  title?: string
  description?: string
}

const {
  title = "Titouan Prat — Développeur d'applications web freelance",
  description = "Développeur d'applications web freelance à Toulouse. Création d'applications, évolutions de produits et outils sur mesure, de la conception à la mise en production.",
} = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
const shareImage = new URL('/og-cover.png', Astro.site)
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Titouan Prat" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Titouan Prat — Développeur d'applications web freelance." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      let theme
      try { theme = localStorage.getItem('theme') } catch {}
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
      if (theme === 'dark' || (!theme && prefersDark)) {
        document.documentElement.classList.add('dark')
      }
    </script>
  </head>
  <body class="bg-white dark:bg-neutral-950 text-neutral-900 dark:text-neutral-100 transition-colors duration-300">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-white focus:text-neutral-900 focus:p-4">Aller au contenu</a>
    <ScrollNav />
    <main id="main" class={Astro.url.pathname === '/' ? '' : 'pt-20 lg:pt-12'}>
      <slot />
    </main>
  </body>
</html>
