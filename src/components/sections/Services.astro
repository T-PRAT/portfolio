---
import SectionHeading from '../ui/SectionHeading.astro'
import { services } from '../../data/portfolio'
---
<section id="services" class="py-24 px-6 md:px-12 lg:px-24 max-w-5xl mx-auto">
  <div class="reveal">
    <SectionHeading label="Offres" title="Ce que je peux faire pour vous" />
  </div>
  <div class="grid gap-4 md:grid-cols-3">
    {services.map((s, i) => (
      <article
        class={'reveal flex flex-col border border-neutral-200 dark:border-neutral-800 rounded-2xl p-6 hover:border-neutral-400 dark:hover:border-neutral-600 transition-colors' }
        style={`transition-delay: ${i * 0.06}s`}
      >
        <h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 leading-snug mb-2">
          {s.title}
        </h3>
        <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
          {s.description}
        </p>
        <ul class="text-sm text-neutral-500 dark:text-neutral-400 space-y-1.5">
          {s.details.map(d => (
            <li class="flex gap-2">
              <span class="text-neutral-300 dark:text-neutral-600 select-none">—</span>
              <span>{d}</span>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>
