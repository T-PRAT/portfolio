---
import SectionHeading from '../ui/SectionHeading.astro'
import ProjectCard from '../ui/ProjectCard.astro'
import { projects } from '../../data/portfolio'
const clients = projects.filter(p => p.kind === 'client')
const sports = projects.filter(p => p.kind === 'perso')
---
<section id="projects" class="page-shell section-space">
  <SectionHeading label="Réalisations" title="Des besoins concrets. Des produits livrés rapidement." />
  <div class="flex flex-col gap-7">{clients.map(project => <div class="w-full md:w-[92%] even:md:ml-auto"><ProjectCard project={project} /></div>)}</div>
  <div class="mt-16 mb-7 flex flex-col md:flex-row md:items-end gap-4 md:gap-12">
    <div class="shrink-0"><p class="eyebrow mb-3">Le terrain comme point de départ</p><h3 class="text-2xl font-bold tracking-tight">Du sport aux produits.</h3></div>
    <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed max-w-xl">Je pratique le trail et le vélo, et je développe les outils dont j'ai besoin : données sportives, capteurs et préparation de course.</p>
  </div>
  <div class="flex flex-col gap-7">{sports.map(project => <div class="w-full md:w-[92%] even:md:ml-auto"><ProjectCard project={project} /></div>)}</div>
</section>
