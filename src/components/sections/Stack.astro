---
const tools = [
  'Agents IA', 'Vue / Nuxt', 'React / Next.js', 'TypeScript', 'Node.js',
  'Strapi', 'Hono', 'Tailwind CSS', 'Google Apps Script', 'Docker', 'Playwright',
]
---
<section id="stack" class="page-shell pb-16 md:pb-24" aria-labelledby="tools-heading">
  <div class="border-y border-neutral-200 dark:border-neutral-800 py-7">
    <h2 id="tools-heading" class="eyebrow mb-4">Quelques outils que j'utilise</h2>
    <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-neutral-600 dark:text-neutral-400">
      {tools.map(tool => <li>{tool}</li>)}
    </ul>
  </div>
</section>
