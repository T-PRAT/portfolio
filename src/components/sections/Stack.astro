---
import SectionHeading from '../ui/SectionHeading.astro'
import { stack } from '../../data/portfolio'
import * as si from 'simple-icons'

const siAny = si as any

interface ItemView {
  name: string
  weight: 1 | 2 | 3
  circleClass: string
  iconWidth: number
  textClass: string
  iconPath: string | null
  iconColor: string | null
  fallback: string
}

const allItems: ItemView[] = stack
  .flatMap(cat => cat.items)
  .sort((a, b) => b.weight - a.weight)
  .map(item => {
    const icon = item.icon ? siAny[item.icon] : null
    const circleClass =
      item.weight === 3 ? 'w-24 h-24' :
      item.weight === 2 ? 'w-[72px] h-[72px]' : 'w-14 h-14'
    const iconWidth =
      item.weight === 3 ? 26 :
      item.weight === 2 ? 20 : 14
    const textClass =
      item.weight === 3 ? 'text-[10px]' :
      item.weight === 2 ? 'text-[8px]' : 'text-[7px]'
    return {
      name: item.name,
      weight: item.weight,
      circleClass,
      iconWidth,
      textClass,
      iconPath: icon ? icon.path : null,
      iconColor: icon ? '#' + icon.hex : null,
      fallback: item.name,
    }
  })
---

<section id="stack" class="reveal py-16 px-6 md:px-12 lg:px-24 max-w-5xl mx-auto">
  <SectionHeading label="Compétences" title="Stack technique" />
  <div id="bubble-field" class="relative w-full h-[520px] sm:h-[420px]">
    {allItems.map((item, i) => (
      <div
        class="bubble absolute flex items-center justify-center opacity-0 cursor-default select-none"
        data-weight={String(item.weight)}
        data-i={String(i)}
        title={item.name}
      >
        <div class={'flex flex-col items-center justify-center gap-1 rounded-full bg-neutral-100 dark:bg-neutral-800 shrink-0 ' + item.circleClass}>
          {item.iconPath && (
            <svg viewBox="0 0 24 24" width={item.iconWidth} height={item.iconWidth} aria-hidden="true" style={'fill:' + item.iconColor}>
              <path d={item.iconPath} />
            </svg>
          )}
          <span class={'font-medium text-neutral-500 dark:text-neutral-400 text-center px-1 leading-tight ' + item.textClass}>
            {item.fallback}
          </span>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .bubble {
    transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .bubble:hover {
    z-index: 10;
  }
</style>

<script>
  function init() {
    const field = document.getElementById('bubble-field')
    if (!field) return

    const bubbles = Array.from(field.querySelectorAll<HTMLElement>('.bubble'))
    if (!bubbles.length) return

    const cw = field.offsetWidth
    const ch = field.offsetHeight
    const cx = cw / 2
    const cy = ch / 2

    // Collision radii matching circle sizes (w-24=96, w-[72px]=72, w-14=56)
    // Shrink bubbles on narrow screens so the whole set fits the field
    const scale = cw < 480 ? 0.85 : 1
    const circleR: Record<string, number> = { '3': 50 * scale, '2': 38 * scale, '1': 30 * scale }

    // Build node array, sort heavy first so they claim center
    const nodes = bubbles.map(el => {
      const w = el.dataset.weight ?? '1'
      const r = circleR[w] ?? 30
      return { el, weight: Number(w), r, x: cx, y: cy, vx: 0, vy: 0 }
    })
    nodes.sort((a, b) => b.weight - a.weight)

    const PAD = 3 // small gap so circles visually "touch"

    // Greedy placement: place each node as close to center as possible
    const placed: Array<{ x: number; y: number; r: number }> = []

    function collides(x: number, y: number, r: number): boolean {
      for (const p of placed) {
        const dx = x - p.x
        const dy = y - p.y
        if (Math.sqrt(dx * dx + dy * dy) < r + p.r + PAD) return true
      }
      return false
    }

    function inBounds(x: number, y: number, r: number): boolean {
      return x - r >= 0 && x + r <= cw && y - r >= 0 && y + r <= ch
    }

    for (const n of nodes) {
      if (placed.length === 0) {
        // First (heaviest) node goes to center
        n.x = cx
        n.y = cy
        placed.push({ x: cx, y: cy, r: n.r })
        continue
      }

      // Try expanding spiral from center to find closest valid spot
      let bestX = cx, bestY = cy, bestDist = Infinity
      let found = false

      for (let dist = 0; dist < Math.max(cw, ch); dist += 4) {
        const steps = Math.max(1, Math.floor((2 * Math.PI * dist) / 8))
        const angleStep = (2 * Math.PI) / steps
        // Randomize start angle slightly for organic feel
        const startAngle = (placed.length * 1.618) % (2 * Math.PI)

        for (let s = 0; s < steps; s++) {
          const angle = startAngle + s * angleStep
          const x = cx + Math.cos(angle) * dist
          const y = cy + Math.sin(angle) * dist

          if (!inBounds(x, y, n.r)) continue
          if (collides(x, y, n.r)) continue

          // Check it touches at least one placed circle (if not first ring)
          if (placed.length > 0 && dist > 0) {
            const touchesAny = placed.some(p => {
              const d = Math.sqrt((x - p.x) * (x - p.x) + (y - p.y) * (y - p.y))
              return d < n.r + p.r + PAD + 10 // close enough to touch
            })
            if (!touchesAny) continue
          }

          const d = Math.sqrt((x - cx) * (x - cx) + (y - cy) * (y - cy))
          if (d < bestDist) {
            bestDist = d
            bestX = x
            bestY = y
            found = true
          }
        }

        if (found) break
      }

      n.x = bestX
      n.y = bestY
      placed.push({ x: bestX, y: bestY, r: n.r })
    }

    // Post-process: shift entire cluster to be centered in container
    let sumX = 0, sumY = 0
    for (const n of nodes) { sumX += n.x; sumY += n.y }
    const avgX = sumX / nodes.length
    const avgY = sumY / nodes.length
    const shiftX = cx - avgX
    const shiftY = cy - avgY
    for (const n of nodes) {
      n.x = Math.max(n.r, Math.min(cw - n.r, n.x + shiftX))
      n.y = Math.max(n.r, Math.min(ch - n.r, n.y + shiftY))
    }

    // Apply positions
    for (const n of nodes) {
      const elW = n.el.offsetWidth || n.r * 2
      const elH = n.el.offsetHeight || n.r * 2
      n.el.style.left = (n.x - elW / 2) + 'px'
      n.el.style.top  = (n.y - elH / 2) + 'px'
      if (scale !== 1) {
        const inner = n.el.firstElementChild as HTMLElement | null
        if (inner) inner.style.transform = 'scale(' + scale + ')'
      }
      n.el.style.opacity = '1'
    }

    // Hover interaction: scale hovered bubble, push overlapping neighbors
    const HOVER_SCALE = 1.3
    const MARGIN = 12 // gap around the hovered bubble

    for (const n of nodes) {
      n.el.addEventListener('mouseenter', () => {
        n.el.style.transform = 'scale(' + HOVER_SCALE + ')'
        n.el.style.zIndex = '10'

        const scaledR = n.r * HOVER_SCALE + MARGIN

        for (const other of nodes) {
          if (other === n) continue
          const dx = other.x - n.x
          const dy = other.y - n.y
          const dist = Math.sqrt(dx * dx + dy * dy)
          const minDist = scaledR + other.r
          if (dist < minDist && dist > 0) {
            const overlap = minDist - dist
            const pushX = (dx / dist) * overlap
            const pushY = (dy / dist) * overlap
            other.el.style.transform = 'translate(' + pushX + 'px, ' + pushY + 'px)'
          }
        }
      })

      n.el.addEventListener('mouseleave', () => {
        n.el.style.transform = ''
        n.el.style.zIndex = ''
        for (const other of nodes) {
          if (other === n) continue
          other.el.style.transform = ''
        }
      })
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init)
  } else {
    init()
  }
</script>
