---
import SectionHeading from '../ui/SectionHeading.astro'
import DarkModeToggle from '../vue/DarkModeToggle.vue'
import { profile } from '../../data/portfolio'
---
<section id="contact" class="reveal py-24 px-6 md:px-12 lg:px-24 max-w-5xl mx-auto snap-start">
  <SectionHeading label="Contact" title="Travaillons ensemble" />
  <p class="text-lg text-neutral-600 dark:text-neutral-400 mb-10 max-w-xl leading-relaxed">
    Disponible pour des missions freelance. N'hésitez pas à me contacter pour discuter de votre projet.
  </p>
  <div class="flex flex-col gap-4">
    <a
      href={`mailto:${profile.email}`}
      class="text-2xl md:text-3xl font-bold text-neutral-900 dark:text-neutral-100 hover:text-blue-600 dark:hover:text-blue-400 transition-colors w-fit"
    >
      {profile.email}
    </a>
    <div class="flex gap-6 mt-2">
      <a
        href={profile.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm font-medium text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
      >
        LinkedIn →
      </a>
      <a
        href={profile.github}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm font-medium text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
      >
        GitHub →
      </a>
    </div>
  </div>
  <div class="mt-24 flex items-center justify-between">
    <p class="text-xs text-neutral-300 dark:text-neutral-700">
      {profile.name} · {profile.location}
    </p>
    <DarkModeToggle client:load />
  </div>
</section>
