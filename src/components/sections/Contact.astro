---
import SectionHeading from '../ui/SectionHeading.astro'
import { profile } from '../../data/portfolio'

const inputClass =
  'w-full bg-transparent border border-neutral-200 dark:border-neutral-800 rounded-xl px-4 py-3 text-sm text-neutral-900 dark:text-neutral-100 placeholder:text-neutral-400 dark:placeholder:text-neutral-600 focus:outline-none focus:border-neutral-500 dark:focus:border-neutral-400 transition-colors'
---
<section id="contact" class="page-shell section-space border-t border-neutral-200 dark:border-neutral-800">
  <SectionHeading label="Contact" title="Travaillons ensemble" />
  <div class="grid gap-12 md:grid-cols-[1fr_1.2fr]">
    <div>
      <p class="text-lg text-neutral-600 dark:text-neutral-400 mb-8 leading-relaxed">
        Une application à créer, un produit à faire évoluer ? Décrivez votre besoin et vos délais, même si le périmètre reste à préciser. Je réponds sous 48 h.
      </p>
      <p class="text-sm text-neutral-500 dark:text-neutral-400 mb-2">Ou par e-mail :</p>
      <a
        id="contact-email"
        href="#"
        data-u={profile.emailUser}
        data-d={profile.emailDomain}
        class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 hover:text-blue-600 dark:hover:text-blue-400 transition-colors w-fit break-all"
      >
        Afficher mon adresse e-mail
      </a>
      <div class="flex gap-6 mt-8">
        <a
          href={profile.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-medium text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
        >
          LinkedIn →
        </a>
        <a
          href={profile.github}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-medium text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
        >
          GitHub →
        </a>
      </div>
    </div>

    <form id="contact-form" action={profile.formspree} method="POST" class="flex flex-col gap-3" novalidate>
      <div class="grid gap-3 sm:grid-cols-2">
        <label class="flex flex-col gap-1.5">
          <span class="eyebrow">Nom</span>
          <input name="name" type="text" required autocomplete="name" placeholder="Votre nom" class={inputClass} />
        </label>
        <label class="flex flex-col gap-1.5">
          <span class="eyebrow">E-mail</span>
          <input name="email" type="email" required autocomplete="email" placeholder="vous@exemple.fr" class={inputClass} />
        </label>
      </div>
      <label class="flex flex-col gap-1.5">
        <span class="eyebrow">Message</span>
        <textarea name="message" required rows="5" placeholder="Votre projet, votre besoin, vos délais…" class={inputClass + ' resize-y min-h-[120px]'}></textarea>
      </label>
      <!-- Honeypot : invisible pour un humain, rempli par les bots -->
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
      <input type="hidden" name="_subject" value="Contact depuis tprat.dev" />
      <div class="flex items-center gap-4 mt-1">
        <button
          type="submit"
          class="button-primary disabled:opacity-50 disabled:cursor-not-allowed"
        >
          Envoyer
        </button>
        <p id="contact-status" class="text-sm text-neutral-500 dark:text-neutral-400" role="status" aria-live="polite"></p>
      </div>
    </form>
  </div>

  <div class="mt-24 flex items-center justify-between">
    <p class="text-sm text-neutral-500 dark:text-neutral-400">
      {profile.name} · {profile.location}
    </p>
    <a href="#hero" class="text-link">Retour en haut ↑</a>
  </div>
</section>

<script>
  // Adresse assemblée au clic : absente du HTML, donc invisible pour les scrapers
  const link = document.getElementById('contact-email') as HTMLAnchorElement | null
  if (link) {
    link.addEventListener('click', (e) => {
      if (link.href.startsWith('mailto:')) return
      e.preventDefault()
      const addr = `${link.dataset.u}@${link.dataset.d}`
      link.href = `mailto:${addr}`
      link.textContent = addr
    })
  }

  const form = document.getElementById('contact-form') as HTMLFormElement | null
  const status = document.getElementById('contact-status')
  if (form && status) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      if (!form.checkValidity()) {
        form.reportValidity()
        return
      }
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')
      if (button) button.disabled = true
      status.textContent = 'Envoi…'
      status.dataset.state = 'pending'
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        })
        if (res.ok) {
          form.reset()
          status.textContent = 'Message envoyé, merci. Je vous réponds rapidement.'
          status.dataset.state = 'success'
        } else {
          const data = await res.json().catch(() => null)
          status.textContent = data?.errors?.[0]?.message ?? "L'envoi a échoué. Réessayez ou écrivez-moi directement."
          status.dataset.state = 'error'
        }
      } catch {
        status.textContent = 'Pas de connexion. Réessayez ou écrivez-moi directement.'
        status.dataset.state = 'error'
      } finally {
        if (button) button.disabled = false
      }
    })
  }
</script>
