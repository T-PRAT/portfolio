---
import SectionHeading from '../ui/SectionHeading.astro'
import { profile, experience, formation } from '../../data/portfolio'

const timelines = [
  { label: 'Expérience', entries: experience },
  { label: 'Formation', entries: formation },
]
---
<section id="about" class="page-shell pb-16 md:pb-24">
  <SectionHeading label="À propos" title="Qui suis-je ?" />
  <div class="grid gap-12 md:grid-cols-[1.4fr_1fr]">
    <div><p class="text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed">
      {profile.bio}
    </p>
    <a href="/cv/" class="button-secondary mt-6">Consulter mon CV <span aria-hidden="true">→</span></a></div>
    <div class="space-y-10">
      {timelines.map(t => (
        <div>
          <p class="text-xs font-semibold tracking-widest uppercase text-neutral-400 dark:text-neutral-500 mb-4">
            {t.label}
          </p>
          <div class="space-y-5">
            {t.entries.map(e => (
              <div class="flex gap-6">
                <span class="text-sm text-neutral-400 dark:text-neutral-500 w-24 shrink-0 mt-0.5 tabular-nums">{e.period}</span>
                <div>
                  <p class="font-semibold text-neutral-900 dark:text-neutral-100 text-sm">{e.title}</p>
                  <p class="text-sm text-neutral-500 dark:text-neutral-400">{e.place}</p>
                  {e.description && (
                    <p class="text-sm text-neutral-500 dark:text-neutral-400 mt-1 leading-relaxed">{e.description}</p>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
