---
import { profile } from '../../data/portfolio'
---
<section id="hero" class="page-shell relative min-h-[100svh] flex flex-col justify-center pt-36 pb-28 md:pt-24 md:pb-28">
  <p class="eyebrow flex items-center gap-2 mb-7"><span class="status-dot h-1.5 w-1.5 rounded-full"></span>{profile.availability}</p>
  <h1 class="text-5xl sm:text-7xl lg:text-8xl font-bold leading-[1.05] tracking-tight mb-6">{profile.name}</h1>
  <p class="text-xl md:text-2xl text-neutral-600 dark:text-neutral-300 font-medium">{profile.title}</p>
  <p class="mt-3 text-sm md:text-base font-medium text-accent-800 dark:text-accent-400">{profile.positioning}</p>
  <p class="mt-7 text-lg md:text-xl text-neutral-600 dark:text-neutral-400 leading-relaxed max-w-2xl">{profile.tagline}</p>
  <div class="flex flex-wrap gap-3 mt-9">
    <a href="#contact" class="button-primary">Parlons de votre projet <span aria-hidden="true">↗</span></a>
    <a href="#projects" class="button-secondary">Voir mes réalisations</a>
  </div>
  <a id="scroll-cue" href="#projects" class="absolute bottom-8 left-6 md:left-12 lg:left-24 inline-flex items-center gap-3 py-2 text-xs text-neutral-500 dark:text-neutral-400 hover:text-accent-800 dark:hover:text-accent-400 transition-colors">
    <span>Découvrir la suite</span>
    <svg class="scroll-cue-arrow" width="14" height="22" viewBox="0 0 14 22" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M7 2v17M2 14l5 5 5-5" /></svg>
  </a>
</section>
<script>
  const cue = document.getElementById('scroll-cue')
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
  let idleTimer: ReturnType<typeof setTimeout>
  function scheduleHint() {
    clearTimeout(idleTimer)
    cue?.classList.remove('is-idle')
    if (window.scrollY > 40 || reducedMotion.matches) return
    idleTimer = setTimeout(() => cue?.classList.add('is-idle'), 4500)
  }
  function updateCue() {
    cue?.classList.toggle('is-dismissed', window.scrollY > 40)
    scheduleHint()
  }
  window.addEventListener('scroll', updateCue, { passive: true })
  window.addEventListener('pointerdown', scheduleHint, { passive: true })
  window.addEventListener('keydown', scheduleHint)
  reducedMotion.addEventListener('change', scheduleHint)
  updateCue()
</script>
