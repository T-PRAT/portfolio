---
import DarkModeToggle from '../vue/DarkModeToggle.vue'
const home = Astro.url.pathname === '/'
const sections = [
  { id: 'hero', label: 'Intro' },
  { id: 'projects', label: 'Projets' },
  { id: 'services', label: 'Offres' },
  { id: 'method', label: 'Méthode' },
  { id: 'stack', label: 'Outils' },
  { id: 'about', label: 'À propos' },
  { id: 'contact', label: 'Contact' },
]
const link = (id: string) => `${home ? '' : '/'}#${id}`
---
<!-- Desktop : petit menu vertical en haut à gauche -->
<nav class="mini-nav hidden lg:flex fixed lg:top-6 lg:left-5 z-50 gap-3" aria-label="Navigation principale">
  <div class="nav-track w-px bg-neutral-200 dark:bg-neutral-800 relative self-start mt-2" aria-hidden="true"><div id="nav-progress" class="absolute top-0 w-full bg-accent-400"></div></div>
  <div class="flex flex-col text-[11px] leading-6 tracking-wide text-neutral-500 dark:text-neutral-400">
    {sections.map(section => <a href={link(section.id)} data-nav-section={section.id} class="mini-nav-link hover:text-neutral-900 dark:hover:text-neutral-100">{section.label}</a>)}
    <a href="/cv/" class="mini-nav-link hover:text-neutral-900 dark:hover:text-neutral-100 mt-2" aria-current={Astro.url.pathname.startsWith('/cv') ? 'page' : undefined}>CV</a>
  </div>
</nav>

<!-- Mobile : barre fine horizontale en haut -->
<div id="scroll-nav-mobile" class="lg:hidden fixed top-0 left-0 right-0 z-50">
  <div class="absolute inset-0 bg-gradient-to-b from-white dark:from-neutral-950 to-transparent pointer-events-none" style="height: 52px;"></div>
  <div class="relative w-full h-px bg-neutral-200 dark:bg-neutral-800">
    <div id="scroll-bar-fill-mobile" class="absolute top-0 left-0 h-full bg-accent-400" style="width: 0%;"></div>
    {sections.map((section, i) => (
      <div
        class="mobile-dot absolute top-1/2 -translate-y-1/2 w-1 h-1 rounded-full bg-neutral-300 dark:bg-neutral-700 transition-colors duration-300"
        style={`left: ${(i / (sections.length - 1)) * 100}%; margin-left: -2px;`}
        data-mobile-dot={section.id}
      ></div>
    ))}
  </div>
  <div class="relative flex justify-between px-4 pt-1">
    {sections.map((section) => (
      <a
        href={link(section.id)}
        data-nav-section={section.id}
        class="mobile-link text-neutral-400 dark:text-neutral-500 hover:text-neutral-700 dark:hover:text-neutral-300 transition-colors duration-200"
        style="font-size: 9px; letter-spacing: 0.05em;"
      >
        {section.label}
      </a>
    ))}
  </div>
</div>

<div class="site-controls fixed top-9 right-3 lg:top-5 lg:right-5 z-50"><DarkModeToggle client:load /></div>
<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav-section]'))
  const dots = Array.from(document.querySelectorAll<HTMLElement>('[data-mobile-dot]'))
  const fill = document.getElementById('nav-progress')
  const fillMobile = document.getElementById('scroll-bar-fill-mobile')
  const sections = links
    .filter(link => !link.classList.contains('mobile-link'))
    .map(link => document.getElementById(link.dataset.navSection!))
    .filter((el): el is HTMLElement => !!el)

  function updateNavigation() {
    if (!sections.length) return
    let active = sections[0].id
    for (const section of sections) {
      if (section.getBoundingClientRect().top <= window.innerHeight * 0.35) active = section.id
    }
    const fullHeight = document.documentElement.scrollHeight - window.innerHeight
    if (window.scrollY >= fullHeight - 2 && fullHeight > 0) active = sections[sections.length - 1].id

    links.forEach(link => {
      if (link.dataset.navSection === active) {
        link.setAttribute('aria-current', 'location')
        link.classList.add('is-active')
      } else {
        link.removeAttribute('aria-current')
        link.classList.remove('is-active')
      }
    })
    dots.forEach(dot => {
      dot.classList.toggle('bg-accent-400', dot.dataset.mobileDot === active)
      dot.classList.toggle('bg-neutral-300', dot.dataset.mobileDot !== active)
      dot.classList.toggle('dark:bg-neutral-700', dot.dataset.mobileDot !== active)
    })

    const progress = fullHeight > 0 ? Math.min(100, window.scrollY / fullHeight * 100) : 0
    if (fill) fill.style.height = `${progress}%`
    if (fillMobile) fillMobile.style.width = `${progress}%`
  }
  window.addEventListener('scroll', updateNavigation, { passive: true })
  window.addEventListener('resize', updateNavigation)
  updateNavigation()
</script>
<style>
  .nav-track { height: 152px; }
  .mini-nav-link { transition: color .2s; }
  .mini-nav-link[aria-current], .mobile-link.is-active { color: var(--accent-text); }
  #scroll-bar-fill-mobile { transition: width .15s linear; }
</style>
