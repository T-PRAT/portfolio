---
export interface Props {
  label?: string
  title: string
}
const { label, title } = Astro.props
---
<div class="mb-12">
  {label && (
    <p class="eyebrow mb-3">
      {label}
    </p>
  )}
  <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 dark:text-neutral-100">
    {title}
  </h2>
</div>
