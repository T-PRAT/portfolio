---
import Tag from './Tag.astro'
import type { Project } from '../../data/portfolio'
export interface Props { project: Project }
const { project } = Astro.props
const label = project.kindLabel ?? (project.kind === 'client' ? 'Mission client' : 'Projet perso')
---
<article id={project.slug} class="project-card group flex flex-col rounded-2xl border border-neutral-200 dark:border-neutral-800 overflow-hidden bg-white dark:bg-neutral-900/30">
  <p class="eyebrow px-6 py-3 border-b border-neutral-200 dark:border-neutral-800">{label} · {project.period}</p>
  {project.image && <div class="relative w-full aspect-[16/10] overflow-hidden bg-neutral-100 dark:bg-neutral-900 border-b border-neutral-200 dark:border-neutral-800">
    <img src={project.image.src} alt={project.image.alt} width={project.image.width} height={project.image.height} loading="lazy" class="w-full h-full object-cover object-top transition duration-500 dark:brightness-[0.82] dark:saturate-[0.85] dark:contrast-[0.95] dark:group-hover:brightness-100 dark:group-hover:saturate-100 dark:group-hover:contrast-100" />
    <div class="pointer-events-none absolute inset-0 hidden bg-neutral-950/30 transition-opacity duration-500 dark:block dark:group-hover:opacity-0" aria-hidden="true"></div>
  </div>}
  <div class="p-6 md:p-7 flex flex-col flex-1">
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 mb-3">
      <h3 class="text-xl font-bold tracking-tight">{project.title}</h3>
      <div class="flex flex-wrap gap-1.5">{project.tags.map(tag => <Tag label={tag} />)}</div>
    </div>
    <p class="text-neutral-600 dark:text-neutral-300 text-sm leading-relaxed mb-5">{project.description}</p>
    {project.highlights && <ul class="space-y-2 text-sm text-neutral-600 dark:text-neutral-400">{project.highlights.map(h => <li class="flex gap-2"><span class="text-accent-600 dark:text-accent-400" aria-hidden="true">↳</span><span>{h}</span></li>)}</ul>}
    {project.note && <p class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed mt-4">{project.note}</p>}
    {(project.url || project.github || project.caseUrl) && <div class="flex flex-wrap gap-x-5 gap-y-3 mt-auto pt-5 border-t border-neutral-200 dark:border-neutral-800">
      {project.url && <a href={project.url} target="_blank" rel="noopener noreferrer" class="text-link" aria-label={`Voir le site de ${project.title} (nouvel onglet)`}>Voir le projet <span aria-hidden="true">↗</span></a>}
      {project.caseUrl && <a href={project.caseUrl} class="text-link">Mon rôle dans le projet <span aria-hidden="true">→</span></a>}
      {project.github && <a href={project.github} target="_blank" rel="noopener noreferrer" class="text-link" aria-label={`Code source de ${project.title} sur GitHub (nouvel onglet)`}>Code source <span aria-hidden="true">↗</span></a>}
    </div>}
  </div>
</article>
