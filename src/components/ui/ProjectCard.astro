---
import Tag from './Tag.astro'
import type { Project } from '../../data/portfolio'

export interface Props { project: Project }
const { project } = Astro.props
const kindLabel = project.kind === 'client' ? 'Client' : 'Projet perso'
---
<article class="group flex flex-col border border-neutral-200 dark:border-neutral-800 rounded-2xl hover:border-neutral-400 dark:hover:border-neutral-600 transition-all duration-200 hover:shadow-sm overflow-hidden">
  {project.image && (
    <div class="w-full aspect-video bg-neutral-100 dark:bg-neutral-900 overflow-hidden">
      <img
        src={project.image}
        alt={`Screenshot de ${project.title}`}
        class="w-full h-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.02]"
        loading="lazy"
      />
    </div>
  )}
  <div class="flex flex-col p-6">
    <p class="text-[11px] font-semibold tracking-widest uppercase text-neutral-400 dark:text-neutral-500 mb-2">
      {kindLabel} · {project.period}
    </p>
    <div class="flex items-start justify-between gap-4 mb-3">
      <h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 leading-snug">
        {project.title}
      </h3>
      <div class="flex items-center gap-2 shrink-0 mt-0.5">
        {project.github && (
          <a
            href={project.github}
            target="_blank"
            rel="noopener noreferrer"
            class="text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
            aria-label={`GitHub — ${project.title}`}
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
            </svg>
          </a>
        )}
        {project.url && (
          <a
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
            aria-label={`Voir ${project.title}`}
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 7h10v10"/><path d="M7 17 17 7"/>
            </svg>
          </a>
        )}
      </div>
    </div>
    <p class="text-sm text-neutral-600 dark:text-neutral-400 mb-4 leading-relaxed">
      {project.description}
    </p>
    {project.highlights && (
      <ul class="text-sm text-neutral-500 dark:text-neutral-400 space-y-1.5 mb-5">
        {project.highlights.map(h => (
          <li class="flex gap-2">
            <span class="text-neutral-300 dark:text-neutral-600 select-none">—</span>
            <span>{h}</span>
          </li>
        ))}
      </ul>
    )}
    <div class="flex flex-wrap gap-1.5 mt-auto">
      {project.tags.map(tag => <Tag label={tag} />)}
    </div>
  </div>
</article>
